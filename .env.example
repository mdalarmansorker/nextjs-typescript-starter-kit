# Copy to .env.local and fill in. See docs/environment-variables.md for every variable.
# Don't set NODE_ENV here: `next dev` sets it to development and `next build` / `next start` to production.

# Public: inlined into the browser bundle at build time. Never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_APP_NAME="Project Name"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The backend API. Read on the server only, so it never reaches the browser.
API_URL=http://localhost:8000/api

# Used by utils/encryption.server.ts. Generate a 32-byte Base64 key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# The old key while rotating ENCRYPTION_KEY: values encrypted with it still decrypt. Remove it later.
ENCRYPTION_KEY_PREVIOUS=

# Header with the visitor's address set by the proxy in front of this app (overwriting what browsers
# send), e.g. cf-connecting-ip (Cloudflare) or x-real-ip (nginx). Passed to the API for its
# per-address limits. Leave empty when there is no such proxy.
TRUSTED_CLIENT_IP_HEADER=
