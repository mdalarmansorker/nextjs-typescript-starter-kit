{
  "name": "nextjs-typescript-starter-kit",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "stylelint": "stylelint \"**/*.{css,scss,js,jsx,ts,tsx}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss,js,jsx,ts,tsx}\" --fix",
    "make:module": "ts-node --project scripts/tsconfig.json scripts/make-module.ts",
    "make:type": "ts-node --project scripts/tsconfig.json scripts/make-type.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "fs-extra": "^11.3.4",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "postcss-styled-syntax": "^0.7.4",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-plugin-logical-css": "^2.1.0",
    "tailwindcss": "^4.3.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.5.32",
    "minimatch": "^11.0.5"
  }
}
